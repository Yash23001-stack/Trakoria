# Prototype PIN used by the current SQLite FastAPI app.
APP_PIN=0000

# Optional local smoke database path. Leave unset to use expenses.db.
# TRAKORIA_DB_PATH=C:\ExpenseTracker\.trakoria\dev-smoke.db

# Supabase/PostgreSQL foundation configuration.
# Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_AUDIENCE=authenticated

# Frontend public Supabase values for browser auth/client tasks.
# Local Supabase uses http://127.0.0.1:56000 by default in this repository.
# Hosted deployments must provide the hosted Supabase project URL and public key.
# Do not place service-role keys, JWT secrets, database URLs, or OAuth secrets in Vite variables.
VITE_SUPABASE_URL=http://127.0.0.1:56000
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REDIRECT_URL=http://localhost:5175/auth/callback
VITE_SUPABASE_RECOVERY_REDIRECT_URL=http://localhost:5175/auth/recovery
